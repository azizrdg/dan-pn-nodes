PORT=8443

# Секрет для заголовка X-Node-Secret
NODE_API_SECRET=change-me

# Адрес gRPC api-инбаунда Xray
XRAY_API_ADDRESS=127.0.0.1:10085

# Reality
REALITY_PRIVATE_KEY=
REALITY_PUBLIC_KEY=
REALITY_DEST=
REALITY_SERVER_NAMES=
REALITY_SHORT_ID=

# Порты протоколов
VLESS_PORT=443
HYSTERIA2_PORT=8443

# Публичный хост/IP для сборки config_link
PUBLIC_HOST=0.0.0.0

# Путь к config.json Xray (используется только fallback-путём для Hysteria2)
XRAY_CONFIG_PATH=/usr/local/etc/xray/config.json

# Самоподписанный сертификат Hysteria2 -> клиенту нужен insecure=1
HYSTERIA2_INSECURE=1

# Тег inbound'ов в config.json (должны совпадать с тем, что генерирует bootstrap.sh)
VLESS_INBOUND_TAG=vless-reality-in
HYSTERIA2_INBOUND_TAG=hysteria2-in
